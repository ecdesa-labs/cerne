{% for line in uses %}
{{ line }}
{% endfor %}
{% if fields|length == 1 %}
use cerne::domain::{EnforcementResult, Invariants, ValueObject, value_object};
{% else %}
use cerne::domain::{DomainError, EnforcementResult, Invariants, ValueObject};
{% endif %}
use serde::{Deserialize, Serialize};

{% if fields|length == 1 %}
{% set field = fields[0] %}
/// In JSON it is the `{{ field.ty }}` itself, and reading it back goes through `new`: the invariants hold there too.
#[value_object]
#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
pub struct {{ name }}({{ field.ty }});

impl ValueObject for {{ name }} {
    type Constructor = {{ field.ty }};

    fn new({{ field.name }}: {{ field.ty }}) -> EnforcementResult<Self> {
        Invariants::new(vec![]).enforce()?;

        Ok(Self({{ field.name }}))
    }
}
{% else %}
/// Reading it from JSON goes through `new`: the invariants hold there too.
#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
#[serde(try_from = "{{ name }}Constructor")]
pub struct {{ name }} {
{% for field in fields %}
    {{ field.name }}: {{ field.ty }},
{% endfor %}
}

#[derive(Deserialize)]
pub struct {{ name }}Constructor {
{% for field in fields %}
    pub {{ field.name }}: {{ field.ty }},
{% endfor %}
}

impl ValueObject for {{ name }} {
    type Constructor = {{ name }}Constructor;

    fn new(constructor: {{ name }}Constructor) -> EnforcementResult<Self> {
        Invariants::new(vec![]).enforce()?;

        Ok(Self {
{% for field in fields %}
            {{ field.name }}: constructor.{{ field.name }},
{% endfor %}
        })
    }
}

impl TryFrom<{{ name }}Constructor> for {{ name }} {
    type Error = DomainError;

    fn try_from(constructor: {{ name }}Constructor) -> EnforcementResult<Self> {
        Self::new(constructor)
    }
}
{% endif %}

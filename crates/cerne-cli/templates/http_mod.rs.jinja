{% if http == "jsonrpc" %}
pub mod rpc;

{% endif %}
use crate::composition_root::CompositionRoot;
use axum::Router;
use std::sync::Arc;

{% if http == "jsonrpc" %}
/// The HTTP API: JSON-RPC 2.0 on `POST /rpc`.
pub fn router(composition_root: Arc<CompositionRoot>) -> Router {
    Router::new()
        .route("/rpc", axum::routing::post(rpc::rpc))
        .with_state(composition_root)
}
{% else %}
/// The HTTP API: one route per endpoint, added by `cerne g endpoint`.
pub fn router(composition_root: Arc<CompositionRoot>) -> Router {
    Router::new()
        .with_state(composition_root)
}
{% endif %}

{% if http == "jsonrpc" %}
pub mod rpc;

{% endif %}
use crate::ports::Ports;
use axum::Router;
use std::sync::Arc;

{% if http == "jsonrpc" %}
/// The HTTP API: JSON-RPC 2.0 on `POST /rpc`.
pub fn router(ports: Arc<Ports>) -> Router {
    Router::new()
        .route("/rpc", axum::routing::post(rpc::rpc))
        .with_state(ports)
}
{% else %}
/// The HTTP API: one route per endpoint, added by `cerne g endpoint`.
pub fn router(ports: Arc<Ports>) -> Router {
    Router::new()
        .with_state(ports)
}
{% endif %}
